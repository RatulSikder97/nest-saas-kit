{
  "name": "nest-saas-kit",
  "version": "1.0.0",
  "description": "Production-grade multi-tenant SaaS backend starter: NestJS 11, TypeORM, PostgreSQL RLS, Redis, BullMQ.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "ts-node --transpile-only src/database/cli/migrate.ts",
    "db:migrate:prod": "node dist/database/cli/migrate.js",
    "db:revert": "ts-node --transpile-only src/database/cli/migrate.ts --revert",
    "db:seed": "ts-node --transpile-only src/database/cli/seed.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.8.0",
    "@nestjs/typeorm": "11.0.3",
    "argon2": "0.45.2",
    "bullmq": "5.81.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.11",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "29.7.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "argon2",
      "msgpackr-extract"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.module.ts",
      "!main.ts",
      "!worker.ts",
      "!database/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
