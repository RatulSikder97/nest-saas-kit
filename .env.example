# Copy to .env and adjust. Every variable is validated at boot (src/config/env.schema.ts).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true
TRUST_PROXY=false
PUBLIC_APP_URL=http://localhost:3000

# Runtime connection: a dedicated, non-owner role. RLS policies apply to it.
DATABASE_URL=postgres://saas_app_user:change-me-app-password@localhost:5432/saas
# Schema owner, used only by `pnpm db:migrate` (creates the runtime role if missing).
DATABASE_MIGRATION_URL=postgres://saas:saas@localhost:5432/saas
DB_POOL_SIZE=10

REDIS_URL=redis://localhost:6379/0

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-000
API_KEY_PEPPER=replace-with-another-32-random-characters-0000
JWT_ISSUER=nest-saas-kit
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_HOURS=72

# Requests per window, per organization (by plan) or per IP (anonymous).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS=60
RATE_LIMIT_FREE=120
RATE_LIMIT_PRO=1200
RATE_LIMIT_ENTERPRISE=6000

IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TTL_SECONDS=60

OUTBOX_POLL_INTERVAL_MS=1000
USAGE_FLUSH_INTERVAL_MS=60000

MAILER_DRIVER=console
MAIL_FROM=no-reply@example.com
